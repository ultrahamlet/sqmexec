; dog.ssq — カプセル犬リグ (human.ssq と同じ関節チェーン方式の四足版)
;   各関節 = translate(親フレームの関節位置へ) → rotate(関節角, pivot=関節原点)
;            → smooth-union(カプセル + 次の関節...)。
;   ポーズ編集: 関節の rotate を選んで回転ギズモ (E)。x=お辞儀/しっぽ振り上げ, y=首振り。
;   階層: 腰(root) ─ 胴 ─ 胸 ─ 首 ─ 頭 ─ 鼻先/左耳/右耳
;                  │         └ 左前脚/右前脚 ─ 前腕 ─ 前足
;                  ├ 左後脚/右後脚 ─ 脛 ─ 後足
;                  └ 尾1 ─ 尾2
;   前方 = -z (鼻先が -z)。色分け: 胴/尾=茶 / 頭=明るい茶 / 左脚=青系 / 右脚=赤系
(scene
  (background 0.25 0.72 0.75)
  (camera (from 2.1 1.15 -2.5) (at 0 0.42 -0.05) (up 0 1 0) (fov 44))
  (light (pos 6 8 -6) (intensity 1.35) (color 1.0 0.95 0.85) (radius 0.6))
  (light (pos -6 3 -3) (intensity 0.35) (color 0.7 0.8 1.0))
  (light (pos 0 8 5) (intensity 0.3) (color 1 1 1))
  (object "ground"
    (surface (color 0.75 0.68 0.55) (ka 0.3) (kd 0.8) (ks 0.08) (phong 8) (roi 1.0))
    (sdf (plane (center 0 0 0))))
  (object "dog"
    (surface (color 0.7 0.7 0.72) (ka 0.24) (kd 0.8) (ks 0.35) (phong 32) (roi 1.0))
    (sdf (translate (t 0 0.52 0.30)                   ; ── root: 腰 (全身の平行移動)
      (rotate (deg 0 0 0 0 0 0)                       ; ── root 姿勢 (全身の向き)
        (smooth-union (k 0.05)
          (mcolor (c 0.62 0.45 0.30)                  ; 尻 (腰まわり)
            (capsule (a 0 0 0.02) (b 0 0 0.10) (radius 0.115)))

          ; ══ 胴 → 胸 → 首 → 頭 ══
          (rotate (deg 0 0 0 0 0 0)                   ; 腰関節 (背骨の付け根)
            (smooth-union (k 0.05)
              (mcolor (c 0.62 0.45 0.30)              ; 胴
                (capsule (a 0 0 0) (b 0 0.02 -0.42) (radius 0.135)))
              (translate (t 0 0.02 -0.42)
                (rotate (deg 0 0 0 0 0 0)             ; 胸関節
                  (smooth-union (k 0.045)
                    (mcolor (c 0.62 0.45 0.30)        ; 胸 (ブリスケット)
                      (capsule (a 0 0 0.04) (b 0 -0.01 -0.10) (radius 0.12)))

                    ; ── 首 → 頭 → 鼻先/耳 ──
                    (translate (t 0 0.06 -0.10)
                      (rotate (deg 0 0 0 0 0 0)       ; 首関節 (x=上下, y=左右)
                        (smooth-union (k 0.04)
                          (mcolor (c 0.66 0.49 0.33)
                            (capsule (a 0 0 0) (b 0 0.15 -0.11) (radius 0.06)))
                          (translate (t 0 0.15 -0.11)
                            (rotate (deg 0 0 0 0 0 0) ; 頭関節 (うなずき/首かしげ)
                              (smooth-union (k 0.035)
                                (mcolor (c 0.72 0.55 0.38)   ; 頭
                                  (capsule (a 0 0 0.02) (b 0 0.02 -0.10) (radius 0.085)))
                                (translate (t 0 -0.02 -0.10)
                                  (rotate (deg 0 0 0 0 0 0)  ; 鼻先
                                    (mcolor (c 0.45 0.32 0.24)
                                      (capsule (a 0 0 0) (b 0 -0.01 -0.10) (radius 0.045)))))
                                (translate (t 0.055 0.07 -0.01)
                                  (rotate (deg 0 0 18 0 0 0) ; 左耳
                                    (mcolor (c 0.5 0.36 0.26)
                                      (capsule (a 0 0 0) (b 0 0.09 0.01) (radius 0.028)))))
                                (translate (t -0.055 0.07 -0.01)
                                  (rotate (deg 0 0 -18 0 0 0) ; 右耳
                                    (mcolor (c 0.5 0.36 0.26)
                                      (capsule (a 0 0 0) (b 0 0.09 0.01) (radius 0.028)))))
                              ))))))

                    ; ── 左前脚 (x+ 側, 青系) ──
                    (translate (t 0.10 -0.02 -0.04)
                      (rotate (deg 0 0 0 0 0 0)       ; 左肩 (x=前後スイング)
                        (smooth-union (k 0.03)
                          (mcolor (c 0.40 0.52 0.78)
                            (capsule (a 0 0 0) (b 0 -0.24 0) (radius 0.05)))
                          (translate (t 0 -0.24 0)
                            (rotate (deg 0 0 0 0 0 0) ; 左前肘
                              (smooth-union (k 0.03)
                                (mcolor (c 0.48 0.60 0.85)
                                  (capsule (a 0 0 0) (b 0 -0.20 0) (radius 0.04)))
                                (translate (t 0 -0.20 0)
                                  (rotate (deg 0 0 0 0 0 0)   ; 左前足首
                                    (mcolor (c 0.56 0.68 0.92)
                                      (capsule (a 0 -0.045 0.02) (b 0 -0.045 -0.09) (radius 0.035)))))))))))

                    ; ── 右前脚 (x- 側, 赤系) ──
                    (translate (t -0.10 -0.02 -0.04)
                      (rotate (deg 0 0 0 0 0 0)       ; 右肩
                        (smooth-union (k 0.03)
                          (mcolor (c 0.78 0.42 0.36)
                            (capsule (a 0 0 0) (b 0 -0.24 0) (radius 0.05)))
                          (translate (t 0 -0.24 0)
                            (rotate (deg 0 0 0 0 0 0) ; 右前肘
                              (smooth-union (k 0.03)
                                (mcolor (c 0.85 0.50 0.42)
                                  (capsule (a 0 0 0) (b 0 -0.20 0) (radius 0.04)))
                                (translate (t 0 -0.20 0)
                                  (rotate (deg 0 0 0 0 0 0)   ; 右前足首
                                    (mcolor (c 0.92 0.58 0.48)
                                      (capsule (a 0 -0.045 0.02) (b 0 -0.045 -0.09) (radius 0.035)))))))))))
                  )))))

          ; ══ 左後脚 (x+ 側, 青系) ══
          (translate (t 0.11 -0.02 0.04)
            (rotate (deg 0 0 0 0 0 0)                 ; 左股関節
              (smooth-union (k 0.035)
                (mcolor (c 0.36 0.48 0.72)            ; 腿 (前下がり)
                  (capsule (a 0 0 0) (b 0 -0.24 -0.06) (radius 0.06)))
                (translate (t 0 -0.24 -0.06)
                  (rotate (deg 0 0 0 0 0 0)           ; 左膝
                    (smooth-union (k 0.03)
                      (mcolor (c 0.44 0.56 0.80)      ; 脛 (後ろ下がり)
                        (capsule (a 0 0 0) (b 0 -0.20 0.08) (radius 0.045)))
                      (translate (t 0 -0.20 0.08)
                        (rotate (deg 0 0 0 0 0 0)     ; 左後足首
                          (mcolor (c 0.52 0.64 0.88)
                            (capsule (a 0 -0.045 0.02) (b 0 -0.045 -0.09) (radius 0.035)))))))))))

          ; ══ 右後脚 (x- 側, 赤系) ══
          (translate (t -0.11 -0.02 0.04)
            (rotate (deg 0 0 0 0 0 0)                 ; 右股関節
              (smooth-union (k 0.035)
                (mcolor (c 0.72 0.38 0.32)
                  (capsule (a 0 0 0) (b 0 -0.24 -0.06) (radius 0.06)))
                (translate (t 0 -0.24 -0.06)
                  (rotate (deg 0 0 0 0 0 0)           ; 右膝
                    (smooth-union (k 0.03)
                      (mcolor (c 0.80 0.46 0.38)
                        (capsule (a 0 0 0) (b 0 -0.20 0.08) (radius 0.045)))
                      (translate (t 0 -0.20 0.08)
                        (rotate (deg 0 0 0 0 0 0)     ; 右後足首
                          (mcolor (c 0.88 0.54 0.44)
                            (capsule (a 0 -0.045 0.02) (b 0 -0.045 -0.09) (radius 0.035)))))))))))

          ; ══ 尾 (2節, 振り上げた状態) ══
          (translate (t 0 0.06 0.12)
            (rotate (deg -38 0 0 0 0 0)               ; 尾の付け根 (x=上下振り, y=左右振り)
              (smooth-union (k 0.025)
                (mcolor (c 0.58 0.42 0.28)
                  (capsule (a 0 0 0) (b 0 0 0.16) (radius 0.032)))
                (translate (t 0 0 0.16)
                  (rotate (deg 22 0 0 0 0 0)          ; 尾先 (カーブ)
                    (mcolor (c 0.52 0.38 0.26)
                      (capsule (a 0 0 0) (b 0 0 0.14) (radius 0.024))))))))
        )))))
)
