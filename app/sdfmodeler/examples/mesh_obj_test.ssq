; mesh_group_surface.ssq — OBJ の o/g グループごとに材質を当てる (2026-08-05)
;
; (mesh (file ..) (group-surface "名前" <(surface ..) と同じ中身>))
;
; ⚠ (group-surface ..) は **差分でなく完全指定**。parse_surface が冒頭で既定値に
;   上書きするので、object の (surface ..) を土台にした部分上書きはできない。
; ⚠ 名前が OBJ の o/g と一致しないと効かない。一致しなければ stderr に
;   「この OBJ のグループ:」として実在する名前を並べて警告する。
; ⚠ 書かなければ完全に従来動作 (mesh シーン156本でビット一致を確認済み)。
;
;   ./sqm -i ../scenes/mesh_group_surface.ssq -o /tmp/g.png -x 640 -y 400 -A 2 -s 2 -D 2

(scene
  (background 0.055 0.065 0.085)
  (camera (from 0.9 2.25 -5.2) (at 0 0.62 0) (up 0 1 0) (fov 30))

  (light (pos -3.2 4.5 -3.6) (intensity 1.25) (color 1.00 0.97 0.92) (radius 0.35))
  (light (pos  3.6 1.8 -2.2) (intensity 0.42) (color 0.72 0.82 1.00) (radius 0.6))

  (object "floor"
    (surface (color 0.30 0.31 0.33) (ka 0.18) (kd 0.72) (ks 0.06) (phong 12) (roi 1.0))
    (sdf (plane (center 0 0 0) (normal 0 1 0) (offset 0))))

  ; 1つのメッシュ・3グループ。object の (surface ..) は「指定の無いグループ」の既定
  (object "boxes"
    (surface (color 0.62 0.62 0.64) (ka 0.16) (kd 0.70) (ks 0.20) (phong 30) (roi 1.0))
    (mesh (file "$SQM_ROOT/assets/three_groups.obj")
          (group-surface "left"
            (color 0.86 0.22 0.16) (ka 0.18) (kd 0.74) (ks 0.24) (phong 40) (roi 1.0))
          (group-surface "right"
            (color 0.20 0.42 0.85) (ka 0.14) (kd 0.52) (ks 0.60) (phong 90) (roi 1.0)
            (shader toon) (param levels 3) (param edge-width 0.25))))
  ; "middle" は指定していない → object の (surface ..) のまま (灰色)
)
