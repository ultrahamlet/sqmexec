; trex.ssq — カプセル T-REX リグ (human/dog と同じ関節チェーン方式)
;   各関節 = translate(親フレームの関節位置へ) → rotate(関節角, pivot=関節原点)
;            → smooth-union(カプセル + 次の関節...)。
;   ポーズ編集: 関節の rotate を選んで回転ギズモ (E)。
;   見どころ: 下顎関節 (deg x マイナスで口が開く)・尾3節・指行性の後脚4関節。
;   階層: 腰(root) ─ 胴 ─ 胸 ─ 首 ─ 頭 ─ 上顎/下顎
;                  │         └ 左前肢/右前肢 (小さい腕: 肩─肘)
;                  ├ 左後脚/右後脚 (股─膝─踵─つま先)
;                  └ 尾1 ─ 尾2 ─ 尾3
;   前方 = -z。色分け: 体=オリーブ / 頭=明るめ / 下顎=暗 / 左肢=青系 / 右肢=赤系
(scene
  (background 0.25 0.72 0.75)
  (camera (from 3.3 1.7 -3.3) (at 0 0.8 0.15) (up 0 1 0) (fov 46))
  (light (pos 6 8 -6) (intensity 1.35) (color 1.0 0.95 0.85) (radius 0.6))
  (light (pos -6 3 -3) (intensity 0.35) (color 0.7 0.8 1.0))
  (light (pos 0 8 5) (intensity 0.3) (color 1 1 1))
  (object "ground"
    (surface (color 0.75 0.68 0.55) (ka 0.3) (kd 0.8) (ks 0.08) (phong 8) (roi 1.0))
    (sdf (plane (center 0 0 0))))
  (object "trex"
    (surface (color 0.7 0.7 0.72) (ka 0.24) (kd 0.8) (ks 0.35) (phong 32) (roi 1.0))
    (sdf (translate (t 0 0.95 0.35)                   ; ── root: 腰 (全身の平行移動)
      (rotate (deg 0 0 0 0 0 0)                       ; ── root 姿勢 (全身の向き)
        (smooth-union (k 0.06)
          (mcolor (c 0.45 0.50 0.32)                  ; 腰まわり
            (capsule (a 0 0 0.02) (b 0 0.02 0.14) (radius 0.20)))

          ; ══ 胴 → 胸 → 首 → 頭 (上顎/下顎) ══
          (rotate (deg 0 0 0 0 0 0)                   ; 背骨の付け根 (前傾姿勢の調整)
            (smooth-union (k 0.06)
              (mcolor (c 0.45 0.50 0.32)              ; 胴 (巨大な胸郭へ)
                (capsule (a 0 0 0) (b 0 -0.02 -0.52) (radius 0.235)))
              (translate (t 0 -0.02 -0.52)
                (rotate (deg 0 0 0 0 0 0)             ; 胸関節
                  (smooth-union (k 0.05)
                    (mcolor (c 0.48 0.53 0.35)        ; 胸
                      (capsule (a 0 0 0.06) (b 0 0.02 -0.14) (radius 0.20)))

                    ; ── 首 → 頭 → 上顎/下顎 ──
                    (translate (t 0 0.12 -0.14)
                      (rotate (deg 0 0 0 0 0 0)       ; 首関節 (x=上下, y=左右)
                        (smooth-union (k 0.045)
                          (mcolor (c 0.48 0.53 0.35)  ; 首 (S字の立ち上がり)
                            (round-cone-ab (a 0 0 0) (b 0 0.22 -0.16) (r1 0.115) (r2 0.085)))
                          (translate (t 0 0.22 -0.16)
                            (rotate (deg 0 0 0 0 0 0) ; 頭関節 (うなずき/首かしげ)
                              (smooth-union (k 0.035)
                                (mcolor (c 0.52 0.56 0.38)   ; 頭蓋
                                  (capsule (a 0 0.02 0.03) (b 0 0.03 -0.14) (radius 0.12)))
                                (translate (t 0 0 -0.14)
                                  (rotate (deg 0 0 0 0 0 0)  ; 上顎 (吻)
                                    (mcolor (c 0.52 0.56 0.38)
                                      (round-cone-ab (a 0 0.01 0) (b 0 -0.01 -0.22) (r1 0.082) (r2 0.055)))))
                                (translate (t 0 -0.07 -0.02)
                                  (rotate (deg -14 0 0 0 0 0) ; 下顎 (x マイナス=口を開く)
                                    (mcolor (c 0.36 0.40 0.27)
                                      (capsule (a 0 0 0) (b 0 -0.02 -0.26) (radius 0.05)))))
                              ))))))

                    ; ── 左前肢 (x+ 側, 青系。小さい腕) ──
                    (translate (t 0.15 -0.06 -0.10)
                      (rotate (deg -18 0 0 0 0 0)     ; 左肩 (少し前へ)
                        (smooth-union (k 0.02)
                          (mcolor (c 0.40 0.52 0.78)
                            (capsule (a 0 0 0) (b 0 -0.13 -0.03) (radius 0.035)))
                          (translate (t 0 -0.13 -0.03)
                            (rotate (deg -25 0 0 0 0 0)   ; 左肘 (前へ曲げ)
                              (mcolor (c 0.50 0.62 0.86)
                                (capsule (a 0 0 0) (b 0 -0.09 -0.05) (radius 0.027))))))))

                    ; ── 右前肢 (x- 側, 赤系) ──
                    (translate (t -0.15 -0.06 -0.10)
                      (rotate (deg -18 0 0 0 0 0)     ; 右肩
                        (smooth-union (k 0.02)
                          (mcolor (c 0.78 0.42 0.36)
                            (capsule (a 0 0 0) (b 0 -0.13 -0.03) (radius 0.035)))
                          (translate (t 0 -0.13 -0.03)
                            (rotate (deg -25 0 0 0 0 0)   ; 右肘
                              (mcolor (c 0.86 0.52 0.44)
                                (capsule (a 0 0 0) (b 0 -0.09 -0.05) (radius 0.027))))))))
                  )))))

          ; ══ 左後脚 (x+ 側, 青系。指行性4関節) ══
          (translate (t 0.16 -0.02 0.02)
            (rotate (deg 0 0 0 0 0 0)                 ; 左股関節
              (smooth-union (k 0.05)
                (mcolor (c 0.36 0.48 0.72)            ; 腿 (ドラムスティック, 前下がり)
                  (round-cone-ab (a 0 0 0) (b 0 -0.34 -0.10) (r1 0.135) (r2 0.082)))
                (translate (t 0 -0.34 -0.10)
                  (rotate (deg 0 0 0 0 0 0)           ; 左膝
                    (smooth-union (k 0.035)
                      (mcolor (c 0.42 0.54 0.78)      ; 脛 (後ろ下がり)
                        (round-cone-ab (a 0 0 0) (b 0 -0.30 0.12) (r1 0.08) (r2 0.052)))
                      (translate (t 0 -0.30 0.12)
                        (rotate (deg 0 0 0 0 0 0)     ; 左踵 (中足骨, 前下がり)
                          (smooth-union (k 0.03)
                            (mcolor (c 0.48 0.60 0.84)
                              (capsule (a 0 0 0) (b 0 -0.21 -0.04) (radius 0.055)))
                            (translate (t 0 -0.21 -0.04)
                              (rotate (deg 0 0 0 0 0 0)   ; 左つま先
                                (mcolor (c 0.55 0.66 0.90)
                                  (capsule (a 0 -0.03 0.03) (b 0 -0.03 -0.17) (radius 0.05))))))))))))))

          ; ══ 右後脚 (x- 側, 赤系) ══
          (translate (t -0.16 -0.02 0.02)
            (rotate (deg 0 0 0 0 0 0)                 ; 右股関節
              (smooth-union (k 0.05)
                (mcolor (c 0.72 0.38 0.32)
                  (round-cone-ab (a 0 0 0) (b 0 -0.34 -0.10) (r1 0.135) (r2 0.082)))
                (translate (t 0 -0.34 -0.10)
                  (rotate (deg 0 0 0 0 0 0)           ; 右膝
                    (smooth-union (k 0.035)
                      (mcolor (c 0.78 0.44 0.38)
                        (round-cone-ab (a 0 0 0) (b 0 -0.30 0.12) (r1 0.08) (r2 0.052)))
                      (translate (t 0 -0.30 0.12)
                        (rotate (deg 0 0 0 0 0 0)     ; 右踵
                          (smooth-union (k 0.03)
                            (mcolor (c 0.84 0.50 0.42)
                              (capsule (a 0 0 0) (b 0 -0.21 -0.04) (radius 0.055)))
                            (translate (t 0 -0.21 -0.04)
                              (rotate (deg 0 0 0 0 0 0)   ; 右つま先
                                (mcolor (c 0.90 0.56 0.46)
                                  (capsule (a 0 -0.03 0.03) (b 0 -0.03 -0.17) (radius 0.05))))))))))))))

          ; ══ 尾 (3節, 水平に伸びて先が軽く下がる) ══
          (translate (t 0 0.02 0.14)
            (rotate (deg -4 0 0 0 0 0)                ; 尾の付け根 (x=上下, y=左右振り)
              (smooth-union (k 0.05)
                (mcolor (c 0.42 0.47 0.30)
                  (round-cone-ab (a 0 0 0) (b 0 0 0.42) (r1 0.145) (r2 0.10)))
                (translate (t 0 0 0.42)
                  (rotate (deg 5 0 0 0 0 0)           ; 尾2
                    (smooth-union (k 0.04)
                      (mcolor (c 0.39 0.44 0.28)
                        (round-cone-ab (a 0 0 0) (b 0 0 0.40) (r1 0.10) (r2 0.06)))
                      (translate (t 0 0 0.40)
                        (rotate (deg 6 0 0 0 0 0)     ; 尾3 (先端)
                          (mcolor (c 0.36 0.41 0.26)
                            (round-cone-ab (a 0 0 0) (b 0 0 0.38) (r1 0.06) (r2 0.022)))))))))))
        )))))
)
