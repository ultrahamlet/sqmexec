; sweep_test.ssq — 掃引チューブ(sweep)の sdfmodeler サンプル。
; 蔓(spline+テーパー) / 配管(折れ線) / リング(closed spline)
(scene
  (background 0.55 0.66 0.86)
  (camera (from 0 2.2 -5.2) (at 0 0.8 0) (up 0 1 0) (fov 48))
  (light (pos -6 9 -5)(intensity 1.4)(color 1 0.96 0.88)(radius 0.5))
  (light (pos  7 4  4)(intensity 0.45)(color 0.7 0.8 1)(radius 0.5))
  (object "ground" (surface (color 0.88 0.89 0.93)(ka 0.2)(kd 0.7)(ks 0.15)(phong 50))
    (sdf (plane (center 0 0 0))))
  (object "vine" (surface (color 0.45 0.68 0.30)(ka 0.16)(kd 0.8)(ks 0.3)(phong 60))
    (sdf (sweep (spline -1.6 0.1 0.0  -1.1 0.5 0.7  -0.5 1.1 0.1  -1.2 1.7 -0.5  -0.6 2.2 0.1)
                (radii 0.2 0.15 0.11 0.07 0.03)(steps 10))))
  (object "pipe" (surface (color 0.30 0.62 0.85)(ka 0.16)(kd 0.8)(ks 0.3)(phong 60))
    (sdf (sweep (points 0.2 0.15 0.6  0.2 1.2 0.6  1.0 1.2 0.6  1.0 0.5 -0.6  1.8 0.5 -0.6)
                (radius 0.13))))
  (object "loop" (surface (color 0.85 0.55 0.25)(ka 0.16)(kd 0.8)(ks 0.3)(phong 60))
    (sdf (sweep (spline 2.6 0.5 0.0  3.2 1.1 0.5  3.8 0.5 0.0  3.2 0.35 -0.5)
                (radius 0.12)(closed)(steps 12))))
)
