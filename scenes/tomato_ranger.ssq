  ; toon forest backdrop: distant trunks, layered crowns, and undergrowth
  (object "forest-trunks"
    (surface (color 0.16 0.10 0.06)(ka 0.28)(kd 0.76)(ks 0.02)(phong 0)(roi 1.0)(shader toon)(param levels 3)(param edge-width 0.20))
    (sdf (union
          (union
