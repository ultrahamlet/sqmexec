    (sdf (union
          (ellipsoid (center -2.6 0.38 2.35) (radii 1.35 0.42 0.26))
          (union
            (ellipsoid (center 2.6 0.38 2.35) (radii 1.35 0.42 0.26))
            (ellipsoid (center 0 0.28 2.45) (radii 2.8 0.28 0.20))))))

  ; round tomato body with a small shoulder
  (object "ranger-body"
    (surface (color 0.94 0.12 0.08)(ka 0.34)(kd 0.84)(ks 0.06)(phong 0)(roi 1.0)(shader toon)(param levels 3)(param edge-width 0.25))
    (sdf (smooth-union (k 0.14)
