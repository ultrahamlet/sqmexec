; tomato_ranger.ssq - new tomato character "Tomato Ranger"
(scene
  (background 0.12 0.24 0.28)
  (camera (from 0.35 1.35 -4.6) (at 0 0.95 0) (up 0 1 0) (fov 38))
  (light (pos -3.4 4.5 -4.0)(intensity 1.70)(color 1.0 0.95 0.88)(radius 0.9))
  (light (pos 3.2 2.4 -2.8)(intensity 0.60)(color 0.72 0.84 1.0)(radius 0.8))
  (light (pos 0 3.2 2.8)(intensity 0.65)(color 1.0 0.98 0.95)(radius 0.8))

  (object "floor"
