            (ellipsoid (center -3.0 3.15 2.55) (radii 1.0 0.72 0.35))
            (ellipsoid (center -1.9 2.55 2.75) (radii 0.85 0.62 0.30)))
          (union
            (ellipsoid (center 1.9 2.75 2.70) (radii 0.85 0.62 0.30))
            (ellipsoid (center 3.0 3.15 2.50) (radii 1.0 0.72 0.35))))))
  (object "forest-underbrush"
