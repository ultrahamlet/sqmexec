; satsumaimo_yuru.ssq — サツマイモのゆるキャラ "おいもちゃん"
;   紡錘形は楕円体 + 上下の round-cone で作る。頭頂に芽の葉
;   推奨: SQM_GI_KD=1 sqm -i satsumaimo_yuru.ssq -o out.png -x 700 -y 860 -A 3 -s 4 -g 32 -D 2 -T aces
(scene
  (background 0.84 0.86 0.88)
  (camera (from 0.45 1.55 -4.0) (at 0 1.00 0) (up 0 1 0) (fov 36))
  (light (pos -3.2 4.2 -3.8)(intensity 1.62)(color 1.0 0.96 0.90)(radius 0.9))
  (light (pos 3.6 2.0 -3.0)(intensity 0.55)(color 0.75 0.84 1.0)(radius 0.8))
  (light (pos 0 3.4 3.0)(intensity 0.70)(color 1.0 0.98 0.95)(radius 0.8))

  (object "floor"
    (surface (color 0.89 0.86 0.81)(ka 0.34)(kd 0.82)(ks 0.10)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.34)(param Kd 0.88)(param Ks 0.12)(param roughness 0.55)(param metallic 0.0)(param Kr 0.0))
    (sdf (plane (center 0 0 0))))
  (object "backdrop"
    (surface (color 0.88 0.90 0.90)(ka 0.38)(kd 0.86)(ks 0.0)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.38)(param Kd 0.90)(param Ks 0.06)(param roughness 0.85)(param metallic 0.0)(param Kr 0.0))
    (sdf (box (center 0 3.0 2.6) (size 7.0 3.2 0.10))))

  ; --- 芋本体 (紡錘形) + 短い腕 + 足 ---
  (object "imo-body"
    (surface (color 0.52 0.16 0.28)(ka 0.28)(kd 0.82)(ks 0.04)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.30)(param Kd 0.86)(param Ks 0.45)(param roughness 0.38)(param metallic 0.0)(param Kr 0.0))
    (displace (amp 0.008) (freq 16) (octaves 3) (mode turbulence))
    (sdf (smooth-union (k 0.12)
           (ellipsoid (center 0 0.85 0) (radii 0.52 0.80 0.48))
           (smooth-union (k 0.12)
             (round-cone-ab (a 0 0.35 0) (b 0.10 0.06 -0.04) (r1 0.30) (r2 0.07))
             (smooth-union (k 0.12)
               (round-cone-ab (a 0 1.35 0) (b -0.07 1.62 0.03) (r1 0.30) (r2 0.11))
               (smooth-union (k 0.10)
                 (mirror (normal -1 0 0) (round-cone-ab (a 0.45 0.85 0) (b 0.68 0.68 -0.05) (r1 0.11) (r2 0.085)))
                 (mirror (normal -1 0 0) (ellipsoid (center 0.22 0.06 -0.30) (radii 0.18 0.06 0.25)))))))))

  ; --- 芽 (茎 + 葉) ---
  (object "imo-sprout"
    (surface (color 0.26 0.48 0.20)(ka 0.30)(kd 0.74)(ks 0.03)(phong 0)(roi 1.0)(shader velvet)(param sheen-color 0.54 0.78 0.36)(param edge-power 2.2)(param sheen 1.4)(param backscatter 0.25)(param nap 0.5)(param nap-scale 30)(param body-dark 0.35)(param sheen-lit 0.6)(param roughness 0.40))
    (sdf (union
           (capsule (a -0.05 1.60 0.02) (b 0.03 1.83 0.03) (radius 0.048))
           (union
             (ellipsoid (center 0.19 1.86 -0.05) (radii 0.21 0.055 0.15))
             (ellipsoid (center -0.15 1.90 0.11) (radii 0.18 0.055 0.20))))))

  ; --- 目 ---
  (object "imo-eyes"
    (surface (color 0.02 0.02 0.03)(ka 0.05)(kd 0.40)(ks 0.05)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.05)(param Kd 0.40)(param Ks 0.75)(param roughness 0.12)(param metallic 0.0)(param Kr 0.0))
    (sdf (mirror (normal -1 0 0) (sphere (center 0.25 0.96 -0.395) (radius 0.135)))))
  (object "imo-catchlight"
    (surface (color 1.0 1.0 1.0)(ka 0.95)(kd 0.4)(ks 0.0)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 1.0)(param Kd 0.4)(param Ks 0.05)(param roughness 0.6)(param metallic 0.0)(param Kr 0.0))
    (sdf (mirror (normal -1 0 0) (sphere (center 0.291 1.028 -0.504) (radius 0.031)))))

  ; --- 口 ---
  (object "imo-mouth"
    (surface (color 0.30 0.08 0.16)(ka 0.20)(kd 0.60)(ks 0.02)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.22)(param Kd 0.70)(param Ks 0.25)(param roughness 0.45)(param metallic 0.0)(param Kr 0.0))
    (sdf (ellipsoid (center 0 0.76 -0.46) (radii 0.10 0.06 0.05))))

  ; --- ほっぺ ---
  (object "imo-blush"
    (surface (color 1.0 0.66 0.60)(ka 0.40)(kd 0.62)(ks 0.0)(phong 0)(roi 1.0)(shader velvet)(param sheen-color 1.0 0.82 0.78)(param edge-power 2.4)(param sheen 1.2)(param backscatter 0.30)(param nap 0.5)(param nap-scale 32)(param body-dark 0.18)(param sheen-lit 0.6)(param roughness 0.40))
    (sdf (mirror (normal -1 0 0) (ellipsoid (center 0.40 0.84 -0.29) (radii 0.115 0.08 0.06)))))
)
