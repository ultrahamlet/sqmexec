; tomato_yuru.ssq — トマトのゆるキャラ "とまころ"
;   丸い実 + 5枚のヘタ。顔は下半分に寄せて重心を低く見せる
;   ⚠ surface の ks は鏡面反射係数 (-D で反射レイが飛ぶ)。実は 0.06 で
;     蝋のような艶を出し、ハイライトは param Ks 側で作る
;   推奨: SQM_GI_KD=1 sqm -i tomato_yuru.ssq -o out.png -x 800 -y 760 -A 3 -s 4 -g 32 -D 2 -T aces
(scene
  (background 0.82 0.88 0.90)
  (camera (from 0.50 1.55 -4.2) (at 0 0.88 0) (up 0 1 0) (fov 38))
  (light (pos -3.2 4.2 -3.8)(intensity 1.62)(color 1.0 0.96 0.90)(radius 0.9))
  (light (pos 3.6 2.0 -3.0)(intensity 0.55)(color 0.75 0.84 1.0)(radius 0.8))
  (light (pos 0 3.4 3.0)(intensity 0.70)(color 1.0 0.98 0.95)(radius 0.8))

  (object "floor"
    (surface (color 0.90 0.86 0.79)(ka 0.34)(kd 0.82)(ks 0.10)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.34)(param Kd 0.88)(param Ks 0.12)(param roughness 0.55)(param metallic 0.0)(param Kr 0.0))
    (sdf (plane (center 0 0 0))))
  (object "backdrop"
    (surface (color 0.88 0.92 0.86)(ka 0.38)(kd 0.86)(ks 0.0)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.38)(param Kd 0.90)(param Ks 0.06)(param roughness 0.85)(param metallic 0.0)(param Kr 0.0))
    (sdf (box (center 0 3.0 2.6) (size 7.0 3.2 0.10))))

  ; --- 実 + 短い腕。頭頂はヘタが座るように少しへこませる ---
  (object "tomato-body"
    (surface (color 0.95 0.16 0.11)(ka 0.34)(kd 0.84)(ks 0.06)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.34)(param Kd 0.82)(param Ks 0.85)(param roughness 0.16)(param metallic 0.0)(param Kr 0.0))
    (sdf (smooth-subtract (k 0.12)
           (smooth-union (k 0.14)
             (ellipsoid (center 0 0.78 0) (radii 0.92 0.80 0.88))
             (mirror (normal -1 0 0) (round-cone-ab (a 0.78 0.72 -0.05) (b 1.06 0.50 -0.10) (r1 0.16) (r2 0.13))))
           (sphere (center 0 1.95 0) (radius 0.55)))))

  ; --- ヘタ (5枚) + 軸 + 足 ---
  (object "tomato-green"
    (surface (color 0.24 0.46 0.17)(ka 0.30)(kd 0.72)(ks 0.03)(phong 0)(roi 1.0)(shader velvet)(param sheen-color 0.52 0.76 0.34)(param edge-power 2.2)(param sheen 1.4)(param backscatter 0.25)(param nap 0.5)(param nap-scale 30)(param body-dark 0.35)(param sheen-lit 0.6)(param roughness 0.40))
    (sdf (union
           (ellipsoid (center 0 1.46 0) (radii 0.22 0.07 0.22))
           (union
             (ellipsoid (center 0.32 1.47 0) (radii 0.36 0.065 0.16))
             (union
               (ellipsoid (center -0.32 1.47 0) (radii 0.36 0.065 0.16))
               (union
                 (ellipsoid (center 0 1.47 0.32) (radii 0.16 0.065 0.36))
                 (union
                   (ellipsoid (center 0 1.47 -0.32) (radii 0.16 0.065 0.36))
                   (union
                     (capsule (a 0 1.42 0) (b 0.04 1.72 0.02) (radius 0.09))
                     (mirror (normal -1 0 0) (ellipsoid (center 0.26 0.07 -0.55) (radii 0.22 0.07 0.30)))))))))))

  ; --- 目 ---
  (object "tomato-eyes"
    (surface (color 0.02 0.02 0.03)(ka 0.05)(kd 0.40)(ks 0.05)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.05)(param Kd 0.40)(param Ks 0.75)(param roughness 0.12)(param metallic 0.0)(param Kr 0.0))
    (sdf (mirror (normal -1 0 0) (sphere (center 0.30 0.92 -0.79) (radius 0.145)))))
  (object "tomato-catchlight"
    (surface (color 1.0 1.0 1.0)(ka 0.95)(kd 0.4)(ks 0.0)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 1.0)(param Kd 0.4)(param Ks 0.05)(param roughness 0.6)(param metallic 0.0)(param Kr 0.0))
    (sdf (mirror (normal -1 0 0) (sphere (center 0.3435 0.9925 -0.907) (radius 0.033)))))

  ; --- 口 (ほぼ埋めて平らな面として見せる) ---
  (object "tomato-mouth"
    (surface (color 0.32 0.06 0.06)(ka 0.20)(kd 0.60)(ks 0.02)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.22)(param Kd 0.70)(param Ks 0.25)(param roughness 0.45)(param metallic 0.0)(param Kr 0.0))
    (sdf (ellipsoid (center 0 0.60 -0.84) (radii 0.15 0.075 0.06))))

  ; --- ほっぺ (艶消しにして地の赤と質感で差をつける) ---
  (object "tomato-blush"
    (surface (color 1.0 0.64 0.56)(ka 0.38)(kd 0.62)(ks 0.0)(phong 0)(roi 1.0)(shader velvet)(param sheen-color 1.0 0.82 0.76)(param edge-power 2.4)(param sheen 1.2)(param backscatter 0.30)(param nap 0.5)(param nap-scale 32)(param body-dark 0.18)(param sheen-lit 0.6)(param roughness 0.40))
    (sdf (mirror (normal -1 0 0) (ellipsoid (center 0.50 0.76 -0.715) (radii 0.16 0.105 0.09)))))
)
