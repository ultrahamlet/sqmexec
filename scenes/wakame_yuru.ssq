; wakame_yuru.ssq — わかめのゆるキャラ "わかめちゃん"
;   左右に張り出した平たいヒレでフロンド (葉体) を表し、微小 displace で波打たせる
;   推奨: SQM_GI_KD=1 sqm -i wakame_yuru.ssq -o out.png -x 700 -y 820 -A 3 -s 4 -g 32 -D 2 -T aces
(scene
  (background 0.80 0.86 0.90)
  (camera (from 0.35 1.45 -3.6) (at 0 0.98 0) (up 0 1 0) (fov 34))
  (light (pos -3.2 4.2 -3.8)(intensity 1.62)(color 1.0 0.96 0.90)(radius 0.9))
  (light (pos 3.6 2.0 -3.0)(intensity 0.55)(color 0.75 0.84 1.0)(radius 0.8))
  (light (pos 0 3.4 3.0)(intensity 0.70)(color 1.0 0.98 0.95)(radius 0.8))

  (object "floor"
    (surface (color 0.88 0.86 0.82)(ka 0.34)(kd 0.82)(ks 0.10)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.34)(param Kd 0.88)(param Ks 0.12)(param roughness 0.55)(param metallic 0.0)(param Kr 0.0))
    (sdf (plane (center 0 0 0))))
  (object "backdrop"
    (surface (color 0.84 0.89 0.92)(ka 0.38)(kd 0.86)(ks 0.0)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.38)(param Kd 0.90)(param Ks 0.06)(param roughness 0.85)(param metallic 0.0)(param Kr 0.0))
    (sdf (box (center 0 3.0 2.6) (size 7.0 3.2 0.10))))

  ; --- 葉体 + 左右のヒレ + 先端 ---
  (object "wakame-body"
    (surface (color 0.10 0.30 0.20)(ka 0.26)(kd 0.80)(ks 0.05)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.28)(param Kd 0.84)(param Ks 0.70)(param roughness 0.28)(param metallic 0.0)(param Kr 0.0))
    (displace (amp 0.006) (freq 14) (octaves 3) (mode turbulence))
    (sdf
      (smooth-union (k 0.11)
        (ellipsoid (center 0 0.95 0) (radii 0.34 0.88 0.10))
        (smooth-union (k 0.11)
          (mirror (normal -1 0 0) (ellipsoid (center 0.357 0.32 0.040) (radii 0.16 0.20 0.09)))
          (smooth-union (k 0.11)
            (mirror (normal -1 0 0) (ellipsoid (center 0.432 0.60 -0.040) (radii 0.16 0.20 0.09)))
            (smooth-union (k 0.11)
              (mirror (normal -1 0 0) (ellipsoid (center 0.459 0.88 0.040) (radii 0.16 0.20 0.09)))
              (smooth-union (k 0.11)
                (mirror (normal -1 0 0) (ellipsoid (center 0.450 1.16 -0.040) (radii 0.16 0.20 0.09)))
                (smooth-union (k 0.11)
                  (mirror (normal -1 0 0) (ellipsoid (center 0.402 1.44 0.040) (radii 0.16 0.20 0.09)))
                  (smooth-union (k 0.11)
                    (mirror (normal -1 0 0) (ellipsoid (center 0.298 1.70 -0.040) (radii 0.16 0.20 0.09)))
                    (smooth-union (k 0.11)
                      (ellipsoid (center 0 1.82 0.01) (radii 0.16 0.15 0.085))
                      (mirror (normal -1 0 0) (ellipsoid (center 0.13 0.055 -0.09) (radii 0.13 0.055 0.16)))))))))))))

  ; --- 目 ---
  (object "wakame-eyes"
    (surface (color 0.02 0.02 0.03)(ka 0.05)(kd 0.40)(ks 0.05)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.05)(param Kd 0.40)(param Ks 0.75)(param roughness 0.12)(param metallic 0.0)(param Kr 0.0))
    (sdf (mirror (normal -1 0 0) (sphere (center 0.15 1.06 -0.09) (radius 0.115)))))
  (object "wakame-catchlight"
    (surface (color 1.0 1.0 1.0)(ka 0.95)(kd 0.4)(ks 0.0)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 1.0)(param Kd 0.4)(param Ks 0.05)(param roughness 0.6)(param metallic 0.0)(param Kr 0.0))
    (sdf (mirror (normal -1 0 0) (sphere (center 0.1845 1.1175 -0.183) (radius 0.026)))))

  ; --- 口 ---
  (object "wakame-mouth"
    (surface (color 0.06 0.16 0.11)(ka 0.18)(kd 0.60)(ks 0.02)(phong 0)(roi 1.0)(shader pbrsurface)(param Ka 0.20)(param Kd 0.70)(param Ks 0.25)(param roughness 0.45)(param metallic 0.0)(param Kr 0.0))
    (sdf (ellipsoid (center 0 0.88 -0.09) (radii 0.065 0.042 0.05))))

  ; --- ほっぺ ---
  (object "wakame-blush"
    (surface (color 1.0 0.62 0.56)(ka 0.40)(kd 0.62)(ks 0.0)(phong 0)(roi 1.0)(shader velvet)(param sheen-color 1.0 0.80 0.74)(param edge-power 2.4)(param sheen 1.2)(param backscatter 0.30)(param nap 0.5)(param nap-scale 32)(param body-dark 0.18)(param sheen-lit 0.6)(param roughness 0.40))
    (sdf (mirror (normal -1 0 0) (ellipsoid (center 0.24 0.92 -0.045) (radii 0.075 0.055 0.045)))))
)
