              (sphere (center 0 1.31 -0.48) (radius 0.075))
              (sphere (center 0 1.67 -0.43) (radius 0.060)))))))

  (object "snowman-face"
    (surface (color 0.018 0.025 0.04) (ka 0.16) (kd 0.62) (ks 0.18) (phong 22))
    (sdf (union
          (ellipsoid (center -0.16 2.10 -0.34) (radii 0.075 0.09 0.055))
          (union
            (ellipsoid (center 0.16 2.10 -0.34) (radii 0.075 0.09 0.055))
            (union
              (sphere (center -0.17 1.90 -0.34) (radius 0.045))
              (union
                (sphere (center -0.06 1.87 -0.37) (radius 0.045))
                (union
