; snowman.ssq - cheerful snowman test render
(scene
  (background 0.08 0.15 0.24)
  (camera (from 0.25 1.45 -5.8) (at 0 1.20 0) (up 0 1 0) (fov 42))

  (light (pos -3.5 5.0 -4.0) (intensity 1.65) (color 1.0 0.96 0.90) (radius 0.8))
  (light (pos 3.0 2.5 -2.0) (intensity 0.55) (color 0.55 0.72 1.0) (radius 0.9))
