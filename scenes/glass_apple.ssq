; glass_apple.ssq — 透明なガラスの青リンゴ (青リンゴ = 黄緑のリンゴ)
;
;   SQM_CAUSTIC_GAIN=26 SQM_CAUSTIC_DEPTH=1
;   .\render.ps1 .\scenes\glass_apple.ssq out.png -Width 1200 -Height 900
;        -AA 8 -Shadow 3 -Depth 6 -Raw "-O 6 -K 16000000:0.0072 -T aces:1.05:2.2"
;
; ⚠ **この build の透過は無色固定**。実測で確認した (2026-08-30):
;   ・glass / ネイティブ透過とも (color ..) は透過色に効かない (指定違いで画素が同一)
;   ・tintglass は解決されるが absorb-r/g/b が届かない。kt 0 にすると不透明になる
;     = 透過は sqm 側の固定処理で、DR シェーダーの吸収は経路に入っていない
;   ・bsdfwine / bsdfsoap は読み込まれた上で不可視になる (surface としては使えない)
;   ・(kt r g b) は解釈されず、そのオブジェクトごと落ちる (kt は scalar のみ)
;   → 色は **kt を絞った単一オブジェクト**で出す。kt が低いほど自分の色が濃い
;     (最終カメラでの実測: 0.85 ≒ 無色 / 0.50 淡い / 0.30 しっかり緑 / 0.18 濃い)。
;     kd と ka も上げないと透過してきた背景に拡散反射が負けて白く飛ぶ
;     (kd 0.58 / 光量 1.75 で色が消えた)。本体 0.24 / 軸 0.15 / 葉 0.32。
;
; ⚠ **材質の比較は必ず最終カメラで行う。** 3個を横に並べて kt を見比べたところ、
;   端の個体ほど緑が濃く見えて「kt が高いほど濃い」と誤読した。実際は個体ごとに
;   視線との角度が違っただけで、関係は逆だった。同じ位置・同じ画角で1個ずつ
;   描き直したら順序が反転する。
;
; ⚠ 形は blob ではなく sdf で作る。blob は scale に対して実際の面が 1.5 倍ほど
;   外に出るので、へこみ (負の blob) との寸法が合わせにくい。smooth-subtract なら
;   くぼみの位置と深さがそのまま出る。
;
; ⚠ **殻 + 芯の二重構造にしてはいけない。** 最初そう作ったが、ほぼ等間隔で並んだ
;   2枚の屈折面がレンズになり、胴に**同心円状の縞**が出た。フォトンを 300万→2000万、
;   集約半径 0.0072→0.0060 に上げても消えない (幾何由来なので当然)。単一オブジェクト
;   にすると跡形もなく消える。殻の無色反射が芯の色を覆う問題も同時に無くなる。
;
; ⚠ 空ドームの exposure 1.0 では上半分が空の写り込みで白く飛ぶ。0.58 まで落とす。
;
; 屈折の先を滑らかにするため空ドームを入れてある (ponde_ring.ssq と同じ理由 —
; 平らな背景を透かすと縁が高周波になり、同じ AA でも粒立つ)。

(scene
  (background 0.62 0.68 0.74)
  (camera (from 0.62 0.80 -1.95) (at 0 0.36 0) (up 0 1 0) (fov 31))

  (light (pos -1.15 2.15 0.95) (intensity 2.95) (color 1.00 0.97 0.90) (radius 0.035))
  (light (pos  1.45 0.85 -1.25) (intensity 0.46) (color 0.72 0.84 0.96) (radius 0.45))

  (object "sky"
    (surface (color 1 1 1)(ka 1)(kd 0)(ks 0)(phong 0)(roi 1)(shader fakesky2)
      (param sundir -0.42 0.70 0.58)(param zenith-color 0.22 0.40 0.62)
      (param horizon-color 0.82 0.80 0.74)(param sun-color 1.00 0.95 0.82)
      (param sun-size 900)(param sun-glow 6)(param cloud-cover 0.38)
      (param cloud-sharp 0.22)(param cloud-scale 1.8)(param horizon-falloff 0.42)
      (param exposure 0.58))
    (mesh (file "$SQM_ROOT/assets/sky_sphere.obj")(scale 60 60 60)))

  (object "floor"
    (surface (color 0.56 0.56 0.58) (ka 0.16) (kd 0.88) (ks 0.02) (phong 10)
             (roi 1.0) (shader plastic)
             (param Ka 0.16) (param Kd 0.88) (param Ks 0.02) (param roughness 0.55))
    (sdf (plane (center 0 0 0) (normal 0 1 0) (offset 0))))

  ; ── リンゴ本体 (単一オブジェクト。kt で色と透明感を両立させる) ──
  (object "apple"
    (surface (color 0.34 0.82 0.06) (ka 0.30) (kd 0.90) (ks 0.34) (phong 150)
             (kt 0.24) (roi 1.47) (shader plastic)
             (param Ks 0.34) (param roughness 0.05))
    (sdf (smooth-subtract (k 0.07)
           (smooth-subtract (k 0.08)
             (smooth-union (k 0.11)
               (ellipsoid (center 0 0.380 0) (radii 0.340 0.300 0.340))
               (ellipsoid (center 0 0.240 0) (radii 0.290 0.240 0.290)))
             (ellipsoid (center 0 0.720 0) (radii 0.165 0.115 0.165)))
           (ellipsoid (center 0 0.000 0) (radii 0.140 0.090 0.140)))))

  ; ── 軸 ─────────────────────────────────────────────────────
  ; ⚠ kt 0.30 では白い針金に見えた。本体と同じ理屈で kt を絞って色を出す。
  (object "stem"
    (surface (color 0.30 0.17 0.05) (ka 0.16) (kd 0.94) (ks 0.14) (phong 90)
             (kt 0.06) (roi 1.47) (shader plastic)
             (param Ks 0.14) (param roughness 0.30))
    (sdf (smooth-union (k 0.02)
           (capsule (a 0 0.560 0) (b 0.030 0.760 0.015) (radius 0.019))
           (capsule (a 0.030 0.760 0.015) (b 0.052 0.830 0.026) (radius 0.024)))))

  ; ── 葉 ─────────────────────────────────────────────────────
  (object "leaf"
    (surface (color 0.40 0.80 0.14) (ka 0.30) (kd 0.90) (ks 0.28) (phong 120)
             (kt 0.32) (roi 1.46) (shader plastic)
             (param Ks 0.28) (param roughness 0.10))
    (sdf (translate (t 0.118 0.812 0.042)
           (rotate (deg 0 -34 -20)
             (ellipsoid (center 0 0 0) (radii 0.098 0.012 0.046))))))
)
